# Sentinel Core Environment Configuration
# Copy this file to .env and fill in your values.
# PLACEHOLDERS ONLY — never commit real secrets, API keys, or passwords.

# Flask Security (replace before production)
SECRET_KEY=change-me-to-a-long-random-string

# Bind address (default: localhost only — do not expose on LAN/WAN by accident)
SHADOWSEYE_BIND_HOST=127.0.0.1
SHADOWSEYE_BIND_PORT=5001

# Initial admin password (optional). If unset on first boot, a random
# password is generated and printed once to the console. Never commit a
# real password here.
# SHADOWSEYE_ADMIN_PASSWORD=

# Database (SQLite by default)
DATABASE_URL=sqlite:///db/sentinel.db

# API Keys — placeholders only; get real keys from respective services
NVIDIA_API_KEY=your-nvidia-nim-api-key
SHODAN_API_KEY=your-shodan-api-key
VIRUSTOTAL_API_KEY=your-virustotal-api-key
HUNTER_API_KEY=your-hunter-io-api-key

# Optional: Email Configuration for notifications
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password

# Production Settings
FLASK_ENV=production
HTTPS_REDIRECT=true
